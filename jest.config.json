{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "setupFilesAfterEnv": [
    "./node_modules/ti4-ttpg-ts/dist/index.js",
    "./src/jest-setup.ts"
  ],
  "moduleNameMapper": {
    "^@tabletop-playground/api$": "ttpg-mock"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/build/",
    "/.git/",
    "/.vscode/",
    "/.idea/",
    "/prebuild/",
    "generate.test"
  ]
}
